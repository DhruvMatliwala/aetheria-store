# ────────────────────────────────────────────────────────────────
# Firebase (Admin SDK - server side only)
# ────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key WITH newlines replaced by \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ────────────────────────────────────────────────────────────────
# Firebase (Client SDK - browser side)
# ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# ────────────────────────────────────────────────────────────────
# Razorpay (Indian payments — UPI / Cards / GPay / Wallets)
# ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ────────────────────────────────────────────────────────────────
# PayPal (International payments)
# ────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
# sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ────────────────────────────────────────────────────────────────
# Resend (Transactional email)
# ────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=PGSharp Keys <orders@yourdomain.com>

# ────────────────────────────────────────────────────────────────
# Security
# ────────────────────────────────────────────────────────────────
# 32-byte hex string for AES-256-GCM key encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=your_64_char_hex_string_here

# ────────────────────────────────────────────────────────────────
# Admin
# ────────────────────────────────────────────────────────────────
# Comma-separated Firebase UIDs allowed to access /admin
NEXT_PUBLIC_ADMIN_UIDS=uid1,uid2

# ────────────────────────────────────────────────────────────────
# App & Notifications
# ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Private Discord Webhook for real-time order & key backup alerts
DISCORD_ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

